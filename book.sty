% ---- Chọn phông chữ toán học ----

% Dùng MnSymbol nếu hệ thống đã cài đặt; nếu không thì dùng bộ ký hiệu mặc định
\IfFileExists{MnSymbol.sty}{\usepackage{MnSymbol}}{%
  \PackageWarning{book}{Khong tim thay MnSymbol.sty; su dung ky hieu toan hoc mac dinh}%
}

% Chọn phông chữ thư pháp và chữ đậm kiểu bảng đen
\usepackage[cal=euler, bb=fourier]{mathalpha}

% Cho phép ký tự toán học in đậm
\newcommand{\hmmax}{0} % Tránh lỗi "Too many math alphabets"
\newcommand{\bmmax}{0} % Tránh lỗi "Too many math alphabets"
\usepackage{bm}

% Chọn phông cho chữ La-tinh, chữ Hy Lạp, chữ số và dấu câu
\usepackage[italic, eulergreek, nolessnomore, noparenthesis, noplusnominus, noequal, nohbar]{mathastext}

% Hiệu chỉnh khoảng cách quanh một số chữ cái La-tinh
\MTsetmathskips{f}{3mu}{0mu}
\MTsetmathskips{y}{2mu}{0mu}
\MTsetmathskips{p}{2mu}{0mu}
\MTsetmathskips{j}{2mu}{0mu}

% ---- Điều chỉnh bố cục trang ----

\usepackage[top=1in, left=1.3in, right=1.3in, bottom=1.2in, footskip=0.7in]{geometry}

% ---- Điều chỉnh khoảng cách ----

% Đặt giãn cách dòng
\usepackage[onehalfspacing]{setspace}

% Điều chỉnh khoảng cách trên dòng
\usepackage{microtype}

% Điều chỉnh khoảng cách trong văn bản
\AtBeginDocument{\frenchspacing}

% ---- Chọn bảng màu ----

\usepackage[x11names]{xcolor}

% ---- Định dạng đầu trang và chân trang ----

% Tùy chỉnh đầu trang và chân trang
\usepackage{fancyhdr}

% Kích hoạt đầu trang và chân trang tùy chỉnh
\pagestyle{fancy}

% Loại bỏ nội dung đầu trang
\renewcommand{\headrulewidth}{0pt}
\fancyhead{}

% Loại bỏ đầu trang/chân trang khỏi trang trắng
\usepackage{emptypage} 

% ---- Định dạng trang bìa ----

% Tùy chỉnh tiêu đề, tác giả và ngày tháng
\usepackage{titling}

% Định dạng tiêu đề
\setlength{\droptitle}{-2cm}
\pretitle{\begin{center}\bfseries\HUGE} 

% Tạo tiêu đề phụ
\newcommand*{\subtitle}[1]{\posttitle{\vskip2cm\par\huge #1\end{center}}}

% Định dạng tác giả
\preauthor{\begin{center}\huge\vskip4cm\lineskip0.5em\begin{tabular}[t]{c}}

% Định dạng ngày tháng
\predate{\begin{center}\huge\vskip2cm}

% --- Định dạng mục lục ---

% Tùy chỉnh mục lục
\usepackage{tocloft}

% Loại bỏ dòng tiêu đề mặc định của mục lục
\renewcommand{\contentsname}{}

% Chỉ đưa phần, chương và mục vào mục lục
\setcounter{tocdepth}{1}

% Đặt phông chữ cho các mục
\renewcommand{\cftpartfont}{\bfseries}
\renewcommand{\cftchapfont}{\scshape}
\renewcommand{\cftsecfont}{\normalfont}

% Đặt phông chữ cho số trang
\renewcommand{\cftchappagefont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}

% Loại bỏ dấu chấm dẫn ở cấp chương
\renewcommand{\cftchapdotsep}{\cftnodots}

% Đặt khoảng cách giữa các dấu chấm dẫn
\renewcommand{\cftdotsep}{10}

% Đặt khoảng cách theo chiều dọc
\setlength{\cftbeforepartskip}{1em}
\setlength{\cftbeforechapskip}{1em}
\setlength{\cftbeforesecskip}{0em}

% Căn chỉnh các số thứ tự
\setlength{\cftsecindent}{0em}

% Đặt độ thụt lề cho các mục
\setlength{\cftchapnumwidth}{3em}
\setlength{\cftsecnumwidth}{4em}

% ---- Định dạng tiêu đề ----

% Tùy chỉnh tiêu đề các cấp
\usepackage{titlesec}

% Định dạng tiêu đề phần
\titleformat{\part}[display]{\Huge\bfseries\centering}{\textsc{Phần}~\thepart.}{2cm}{}[]

% Định dạng tiêu đề chương
\titleformat{\chapter}[display]{\huge\bfseries}{\textsc{Chương}~\thechapter.}{2cm}{}[\vskip2cm]

% Định dạng tiêu đề mục
\titleformat*{\section}{\large\bfseries}

% Định dạng tiêu đề tiểu mục
\titleformat*{\subsection}{\bfseries}

% Định dạng tiêu đề đoạn
\titleformat{\paragraph}[runin]{\itshape}{}{}{}[\@addpunct{.}\hspace{1em}]

% Thêm dấu chấm sau số thứ tự tiêu đề
\titlelabel{\thetitle.\hspace{1em}}

% ---- Định dạng định lý và chứng minh ----

% Bổ sung các môi trường định lý
\usepackage{amsthm}

% Định nghĩa kiểu định lý
\newtheoremstyle{paper}{0.5em}{0.5em}{\itshape}{}{\scshape}{.}{1em}{}

% Áp dụng kiểu định lý
\theoremstyle{paper}

% Định nghĩa tên các môi trường định lý
\newtheorem{theorem}{Định lý}[chapter]
\newtheorem{proposition}{Mệnh đề}[chapter]
\newtheorem{lemma}{Bổ đề}[chapter]
\newtheorem{corollary}{Hệ quả}[chapter]
\newtheorem{definition}{Định nghĩa}[chapter]
\newtheorem{assumption}{Giả thiết}[chapter]
\newtheorem{remark}{Nhận xét}[chapter]
\newtheorem{result}{Kết quả}[chapter]
\renewcommand{\proofname}{Chứng minh}

% Cho phép bổ sung và điều chỉnh lệnh
\usepackage{etoolbox}

% Định dạng môi trường chứng minh
\renewenvironment{proof}[1][\proofname]{\par\parskip0pt\pushQED{\qed}\normalfont\topsep0.5em\relax\trivlist\item[\hskip\labelsep\upshape\scshape#1\@addpunct{.}\hspace{1em}]\ignorespaces}{\popQED\endtrivlist\@endpefalse}

% ---- Định dạng hình và bảng ----

% Cho phép chèn hình ảnh
\usepackage{graphicx}

% Cải thiện định dạng bảng
\usepackage{booktabs}


% Cho phép bảng trải dài nhiều trang và căn chỉnh cột nâng cao
\usepackage{longtable}
\usepackage{array}
% Cho phép xoay bảng và hình
\usepackage{rotating}

% Cho phép ô trải trên nhiều hàng
\usepackage{multirow}

% Cho phép hình và bảng nhỏ nằm trên trang riêng
\renewcommand{\floatpagefraction}{0}

% Căn giữa hình và bảng
\makeatletter\g@addto@macro\@floatboxreset\centering\makeatother 

% Điều chỉnh khoảng cách trong bảng
\renewcommand{\arraystretch}{1.2}

% Đặt cỡ chữ trong bảng
\BeforeBeginEnvironment{tabular*}{\footnotesize}

% Hiển thị tên bảng và hình bằng chữ hoa nhỏ
\renewcommand{\tablename}{\textsc{Bảng}}
\renewcommand{\figurename}{\textsc{Hình}}

% Tùy chỉnh chú thích
\usepackage{caption, subcaption}

% Định dạng dấu phân cách nhãn
\DeclareCaptionLabelSeparator{periodem}{.\hspace{1em}}

% Định dạng chú thích
\captionsetup{labelsep=periodem}

% Đặt chú thích bảng phía trên bảng
\captionsetup[table]{position=top}

% Định dạng chú thích con
\captionsetup[sub]{labelformat=simple, labelsep=periodem, size=footnotesize}

% Dùng chữ hoa cho nhãn hình con
\renewcommand{\thesubfigure}{\Alph{subfigure}}

% Tạo ghi chú cho bảng và hình
\NewDocumentCommand{\note}{o m}{%
\parbox{\linewidth}{\footnotesize\vspace*{10pt}%
\IfValueT{#1}{\textit{#1}.\hspace{1em}}%
#2}}

% ---- Điều chỉnh việc ngắt trang giữa các công thức ----

% Cung cấp \allowdisplaybreaks và các môi trường toán học chuẩn
\usepackage{amsmath}
\AtBeginDocument{\allowdisplaybreaks[1]}

% ---- Định dạng danh sách ----

% Tùy chỉnh danh sách
\usepackage{enumitem}

% Định dạng danh sách ký hiệu
\setlist[itemize, 1]{leftmargin=\parindent, label=\color{gray}{\upshape\textbullet}, topsep=0.5em, itemsep=0.5em, parsep=0pt} % First level
\setlist[itemize, 2]{leftmargin=2\parindent, label=\color{gray}{\upshape\textendash}, topsep=0.25em, itemsep=0.25em, parsep=0pt} % Second level

% Định dạng danh sách đánh số
\setlist[enumerate, 1]{leftmargin=\parindent, label=\color{gray}{\upshape\arabic*.}, topsep=0.5em, itemsep=0.5em, parsep=0pt} % First level
\setlist[enumerate, 2]{leftmargin=2\parindent, label=\color{gray}{\upshape\Alph*.}, topsep=0.25em, itemsep=0.25em, parsep=0pt} % Second level

% ---- Định dạng phụ lục ----

\apptocmd{\appendix}{%
\titleformat{\chapter}[display]{\huge\bfseries}{\textsc{Phụ lục}~\thechapter.}{2cm}{}[\vskip2cm]%
}{}{}

% ---- Định dạng tài liệu tham khảo ----

% Cải thiện phần tài liệu tham khảo
\usepackage{natbib}
\renewcommand{\bibname}{Tài liệu tham khảo}

% Loại bỏ dấu phân cách giữa tác giả và năm trong trích dẫn
\setcitestyle{aysep={}}

% Đặt cỡ chữ cho tài liệu tham khảo
\renewcommand{\bibfont}{\small}

% Đặt khoảng cách giữa các tài liệu tham khảo
\setlength{\bibsep}{0pt}

% Đặt độ thụt lề cho tài liệu tham khảo
\setlength{\bibhang}{\parindent}

% Thêm tài liệu tham khảo vào mục lục
\usepackage[nottoc]{tocbibind}

% ---- Tạo chỉ mục (chú thích lệnh nếu không cần chỉ mục) ----

\usepackage{imakeidx}
\renewcommand{\indexname}{Chỉ mục}
\makeindex[intoc]

